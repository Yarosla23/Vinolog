FROM debian:bookworm-slim

RUN sed -i 's/Components: main/Components: main non-free/' /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends unrar unzip ca-certificates python3 \
    && rm -rf /var/lib/apt/lists/*

COPY scripts/init-dataset.sh /usr/local/bin/init-dataset
COPY scripts/build-media-manifest.py /usr/local/bin/build-media-manifest.py
RUN chmod +x /usr/local/bin/init-dataset

ENTRYPOINT ["/usr/local/bin/init-dataset"]
